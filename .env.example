# Copy this file to ".env" and replace all example values.
ADMIN_PASSWORD=choose-a-long-password-here
# Keep this stable between deployments so active sessions remain valid.
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000

# Railway PostgreSQL connection used by the Next.js app and migration scripts.
DATABASE_URL=postgresql://user:password@host:5432/database
# Set PGSSL=true if the provider requires TLS but the URL does not specify it.
# PGSSL=true

# Image storage. Leave these unset to store uploads on the local disk
# (public/uploads). Set CLOUDINARY_URL to send uploads to Cloudinary instead.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud-name
# Folder inside your Cloudinary account (the existing portfolio migrates here).
CLOUDINARY_FOLDER=PerfectEvent4U

# Alternative to CLOUDINARY_URL: set the three values separately.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# Where data/*.json and local uploads live. On Railway, point this at a volume.
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads

# Set when running behind a proxy (Railway, Render, Fly, etc.)
# TRUST_PROXY=1
